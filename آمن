class CoreVulnerabilityScanner:
    """
    A core class for scanning network targets, focusing on port scanning
    and basic service banner identification.
    """
    DEFAULTTIMEOUT = 1.5   Define a constant for socket timeout

    def init(self, target: str):
        """
        Initializes the scanner with a target URL or hostname.

        Args:
            target (str): The target URL or hostname to scan.
        """
        if not isinstance(target, str) or not target:
            raise ValueError("Target must be a non-empty string.")
            
        self.target = target
        self.host = self.extracthost(target)
        if not self.host:
            raise ValueError(f"Could not extract a valid hostname from target: {target}")
        self.openports = []
        self.lock = threading.Lock()  Add a lock for thread-safe access to openports

    def extracthost(self, targeturl: str) -> str | None:
        """
        Extracts the hostname or IP address from the user input URL.
        Adds 'http://' prefix if missing for proper parsing.

        Args:
            targeturl (str): The input URL or hostname.

        Returns:
            str | None: The extracted hostname, or None if parsing fails.
        """
        if not targeturl.startswith(('http://', 'https://')):
            targeturl = 'http://' + targeturl
        try:
            parsed = urlparse(targeturl)
            return parsed.hostname
        except Exception as e:
            logging.error(f"Error parsing URL '{targeturl}': {e}")
            return None

    def checkport(self, port: int) -> None:
        """
        Scans a specific port on the target host. If the port is open,
        it attempts to grab a service banner.

        Args:
            port (int): The port number to scan.
        """
        if not isinstance(port, int) or not (0 < port < 65536):
            logging.warning(f"Invalid port number provided: {port}. Skipping.")
            return

        sock = None  Initialize sock to None
        try:
            sock = socket.socket(socket.AFINET, socket.SOCKSTREAM)
            sock.settimeout(self.DEFAULTTIMEOUT)
            result = sock.connectex((self.host, port))
            
            if result == 0:
                 Port is open, add to list thread-safely
                with self.lock:
                    self.openports.append(port)
                
                banner = "Unknown Service"  Default banner info
                try:
                     Attempt to get a banner. Sending HEAD is common for HTTP,
                     but other services might require different probes.
                     For a general scanner, a simple connection might suffice,
                     or specific probes for common ports.
                     This example keeps the HEAD request for HTTP-like services.
                    sock.sendall(b"HEAD / HTTP/1.1\r\nHost: " + self.host.encode() + b"\r\n\r\n")
                    receiveddata = sock.recv(1024)
                    if receiveddata:
                        bannerstr = receiveddata.decode(errors='ignore').strip()
                         Extract the first line as banner info, limit length
                        banner = bannerstr.split('\n', 1)[0][:70]  Limit banner length for display
                except socket.timeout:
                    banner = "Service Timeout"
                except Exception as bannerex:
                    logging.debug(f"Error during banner grabbing for port {port}: {bannerex}")
                    banner = "Banner Grab Failed"
                
                print(f"{GREEN}[+] Port {port:<5} [OPEN] | Service Info: {banner}{RESET}")
             else: Port is closed or filtered, no output needed for this function's scope.

        except socket.gaierror:
            logging.error(f"Address resolution error for host: {self.host}. Check hostname or DNS.")
        except socket.timeout:
             This specific timeout is for connectex, which is unlikely to trigger here
             if settimeout is applied before connectex. More likely for send/recv.
            logging.debug(f"Connection timed out for port {port} on {self.host}.")
        except ConnectionRefusedError:
            logging.debug(f"Connection refused for port {port} on {self.host}.")
        except Exception as e:
             Catching specific exceptions is better than a broad 'except Exception:'
             This broad catch is for unexpected issues.
            logging.error(f"An unexpected error occurred while checking port {port} on {self.host}: {e}")
        finally:
            if sock:
                sock.close()

